{
  "name": "freeforge-editor",
  "displayName": "FreeForge Editor Bridge",
  "description": "Phase 2 agent panel: streaming chat, context chips, reviewable apply/reject — shared state with MAINFRAME CLI. VS Code Extension API only.",
  "version": "0.2.0",
  "publisher": "mainframe",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:freeforge.chatToTask",
    "onCommand:freeforge.openAgent",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "freeforge.openAgent", "title": "FreeForge: Open Agent Panel" },
      { "command": "freeforge.chatToTask", "title": "FreeForge: Chat to Task" },
      { "command": "freeforge.attachSelection", "title": "FreeForge: Attach Selection to Task" },
      { "command": "freeforge.syncDirtyBuffers", "title": "FreeForge: Sync Unsaved Buffers" },
      { "command": "freeforge.applyProposal", "title": "FreeForge: Apply Proposal" },
      { "command": "freeforge.rejectProposal", "title": "FreeForge: Reject Proposal" },
      { "command": "freeforge.cancelTask", "title": "FreeForge: Cancel Task" },
      { "command": "freeforge.resumeTask", "title": "FreeForge: Resume Task" }
    ],
    "configuration": {
      "title": "FreeForge",
      "properties": {
        "freeforge.python": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter for mainframe CLI"
        },
        "freeforge.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "MAINFRAME / project root (empty = workspace folder)"
        }
      }
    }
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "local" }
}
